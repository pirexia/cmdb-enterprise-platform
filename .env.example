# ══════════════════════════════════════════════════════════════════════════════
# CMDB Enterprise Platform — Environment Variables Template
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values    (see each section for guidance)
# 3. Run installer:    bash scripts/install.sh
#    — OR manually:    docker compose -f docker-compose.prod.yml up -d --build
#
# Architecture (production):
#   Browser → nginx:443 (HTTPS) → frontend:3001 | backend:3000 → postgres:5432
#   Only nginx exposes host ports. Frontend and backend are internal-only.
#   TLS certificates live in ./certs/  (server.crt + server.key).
#
# Architecture (development):
#   docker-compose.yml exposes frontend:3001 and backend:3000 directly on host.
# ══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=cmdb_db
POSTGRES_USER=admin                         # Change in production!
POSTGRES_PASSWORD=cmdb_pass123              # Change in production! Use: openssl rand -base64 32
POSTGRES_PORT=5432                          # Dev only: host port mapped to the DB container

# ─── Backend API ──────────────────────────────────────────────────────────────
BACKEND_PORT=3000                           # Internal container port (not exposed in prod)

# JWT secret — generate a strong random value:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
FRONTEND_PORT=3001                          # Internal container port (not exposed in prod)

# Public URL — the address users type in the browser.
# Production (nginx gateway, same host for API and frontend):
#   NEXT_PUBLIC_API_URL=https://cmdb.yourdomain.com
# Local dev with nginx gateway:
#   NEXT_PUBLIC_API_URL=https://localhost
# Local dev without nginx (direct ports):
#   NEXT_PUBLIC_API_URL=http://localhost:3000
# ⚠ This value is BAKED INTO the frontend image at build time.
#   Changing it requires a full container rebuild.
NEXT_PUBLIC_API_URL=https://localhost

# Same as NEXT_PUBLIC_API_URL — used by the backend for CORS and SSO callbacks.
FRONTEND_URL=https://localhost

# ─── nginx Gateway Ports (production only) ────────────────────────────────────
# Override only when you cannot use the standard ports (e.g. rootless Podman
# on RHEL where ports < 1024 require sysctl net.ipv4.ip_unprivileged_port_start).
# Defaults: 443 (HTTPS) and 80 (HTTP → HTTPS redirect).
NGINX_HTTPS_PORT=443
NGINX_HTTP_PORT=80

# ─── Security / TLS ───────────────────────────────────────────────────────────
# Set to true when running the backend directly (without nginx gateway).
# With nginx, the backend receives plain HTTP internally — set to false.
HTTPS_ENABLED=false

# Allowed CORS origins (comma-separated). Backend rejects all other Origins.
# With nginx gateway, frontend and API share the same origin — use that URL.
CORS_ORIGINS=https://localhost

# ─── Adminer (DB admin UI — development only) ─────────────────────────────────
ADMINER_PORT=8080                           # Access at http://localhost:8080 (dev only)

# ─── Document Repository ──────────────────────────────────────────────────────
# Host path where uploaded documents are stored (bind-mounted into the backend).
# Examples:
#   DOCUMENTS_STORAGE_PATH=./document-storage          # relative to compose file (default)
#   DOCUMENTS_STORAGE_PATH=/mnt/nfs/cmdb-docs          # NFS mount point
#   DOCUMENTS_STORAGE_PATH=/data/cmdb/documents        # absolute local path
# The directory must exist and be writable by UID 1000 (the node user in Alpine).
DOCUMENTS_STORAGE_PATH=./document-storage

# Maximum file size for document uploads (MB). Default: 50 MB.
MAX_DOCUMENT_SIZE_MB=50

# ─── Alert Engine / Email Notifications ───────────────────────────────────────
# Leave SMTP_USER empty to disable outgoing email alerts entirely.
#
# Gmail example (use an App Password — not your regular password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # 16-char App Password
#
# Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=your@company.com
#   SMTP_PASS=yourpassword
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Destination address for all alert reports.
ALERT_RECIPIENT=admin@yourdomain.com

# Days ahead to start warning about expiring items (default: 30).
ALERT_WARN_DAYS=30

# Cron schedule for the daily alert job (default: 08:30 AM).
# Use "* * * * *" to trigger every minute for testing.
# Syntax: minute hour day month weekday
ALERT_CRON_SCHEDULE=30 8 * * *

# ─── Audit Log Retention ──────────────────────────────────────────────────────
# Retention period for audit logs (days). Older records are purged automatically.
# Default: 365 days. Set to 0 to disable automatic purge.
AUDIT_RETENTION_DAYS=365

# ─── MFA / Trusted Devices ────────────────────────────────────────────────────
# Days before a trusted device must re-authenticate with MFA (default: 30).
TRUSTED_DEVICE_TTL_DAYS=30
# Mirror of the above — shown in the UI (must match the backend value).
NEXT_PUBLIC_TRUSTED_DEVICE_TTL_DAYS=30

# ─── Password Policy (local users only — LDAP/AD/SSO users are excluded) ──────
# Minimum password length for ADMIN users (default: 16).
PASSWORD_MIN_LENGTH_ADMIN=16
# Minimum password length for AUDITOR and VIEWER users (default: 12).
PASSWORD_MIN_LENGTH_VIEWER=12
# Number of previous passwords stored per user; user cannot reuse last N (default: 20).
PASSWORD_HISTORY_COUNT=20

# ─── Application Environment ──────────────────────────────────────────────────
# Controls logging verbosity. Values: 'prod' (warn/error only) or 'dev' (verbose).
APP_ENV=prod
NEXT_PUBLIC_APP_ENV=prod

# ─── Corporate Branding (White-Label) ─────────────────────────────────────────
# Customize the platform with your company's identity.
NEXT_PUBLIC_COMPANY_NAME=CMDB Enterprise
# Serve a custom logo from ./frontend/public/logo.png — or leave as /logo.png.
NEXT_PUBLIC_LOGO_URL=/logo.png
# Primary theme color (hex). Default: indigo.
NEXT_PUBLIC_THEME_COLOR=#4f46e5

# ─── LDAP / Active Directory Authentication (optional) ────────────────────────
# Set USE_LDAP=true to enable hybrid authentication (local + LDAP/AD).
# When enabled, logins that don't end in @cmdb.local are first validated against
# LDAP. On first successful LDAP login, a shadow VIEWER account is auto-created.
# If LDAP is unreachable the local bcrypt path takes over (fail-safe, 5s timeout).
#
# Minimal (UPN bind — works for AD):
#   USE_LDAP=true
#   LDAP_URL=ldap://dc.corp.local:389
#   LDAP_SEARCH_BASE=dc=corp,dc=local
#
# Full (service-account bind — recommended for AD):
#   USE_LDAP=true
#   LDAP_URL=ldap://dc.corp.local:389
#   LDAP_BIND_DN=cn=svc-cmdb,ou=ServiceAccounts,dc=corp,dc=local
#   LDAP_BIND_PASSWORD=ServiceAccountPassword
#   LDAP_SEARCH_BASE=ou=Users,dc=corp,dc=local
USE_LDAP=false
LDAP_URL=ldap://dc.corp.local:389
LDAP_BASE_DN=dc=corp,dc=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Uncomment only for LDAPS with self-signed / internal CA cert:
# LDAP_TLS_REJECT_UNAUTHORIZED=0
# LDAP_STRICT_MODE=true  # Block local auth fallback when LDAP is unreachable.
#                        # Only relevant when USE_LDAP=true.
#                        # Default: false (safe because shadow users have random hashes).

# ─── Microsoft 365 SSO / Azure AD (optional) ──────────────────────────────────
# Register an app at https://portal.azure.com → App registrations.
# Redirect URI must be: https://<your-domain>/api/auth/sso/microsoft/callback
# Permissions required: openid, profile, email (delegated).
USE_MICROSOFT_SSO=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://localhost/api/auth/sso/microsoft/callback
AZURE_ALLOWED_DOMAIN=yourdomain.com
# Set to true to auto-create VIEWER accounts for first-time SSO users.
AZURE_AUTO_PROVISION=false

# ── RAG / Asistente IA ────────────────────────────────────────────────────────
# Activa o desactiva el subsistema RAG completo (true/false)
RAG_ENABLED=true

# URL interna de Ollama (NO cambiar salvo que uses Ollama externo)
OLLAMA_BASE_URL=http://ollama:11434

# Modelos — ver docs/RAG_HOST_PREPARATION.md §Apéndice B para opciones
RAG_EMBED_MODEL=bge-m3
RAG_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M

# Temperatura del LLM (0.0–1.0; bajo = más determinista)
RAG_CHAT_TEMPERATURE=0.1

# Fragmentos recuperados por consulta
RAG_TOP_K=6

# Peticiones de chat por usuario por minuto
RAG_RATE_LIMIT_PER_MIN=10

# Ruta de modelos Ollama en producción (bind-mount en docker-compose.prod.yml)
OLLAMA_MODELS_PATH=/opt/cmdb-data/ollama-models

# Importación masiva de CIs: análisis IA concurrente.
# Default 3, rango 1..5. Valores fuera de rango se clampan a 3.
# CI analysis es ligero (no usa OCR), por lo que 3 hilos saturan Ollama sin
# afectar al resto del sistema. Subir a 5 solo si dispones de >=8 cores.
CI_BULK_CONCURRENCY=3
