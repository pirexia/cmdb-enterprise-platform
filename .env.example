# ══════════════════════════════════════════════════════════════════════════════
# CMDB Enterprise Platform — Environment Variables
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values
# 3. Run:              docker compose up -d --build
# ══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=cmdb_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=cmdb_pass123          # Change in production!
POSTGRES_PORT=5432                      # Host port mapped to the DB container

# ─── Backend API ──────────────────────────────────────────────────────────────
BACKEND_PORT=3000                       # Host port mapped to the backend container

# JWT secret — use a long random string in production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
FRONTEND_PORT=3001                      # Host port mapped to the frontend container

# URL of the backend API as seen from the USER'S BROWSER (not from inside Docker).
# In production, replace with your real domain or server IP:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Note: this value is BAKED INTO the frontend image at build time.
#       Changing it after build requires a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Adminer (DB admin UI) ────────────────────────────────────────────────────
ADMINER_PORT=8080                       # Access at http://localhost:8080

# ─── Security / TLS (Misión 13) ───────────────────────────────────────────────
# Enable HTTPS on the backend (requires certs in backend/certs/).
# Generate certs: bash backend/scripts/generate-certs.sh
#                 (or: powershell -File backend\scripts\generate-certs.ps1)
HTTPS_ENABLED=false

# Allowed CORS origins (comma-separated). Backend rejects all other Origins.
# In production replace with your real domain(s).
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# When HTTPS_ENABLED=true, update NEXT_PUBLIC_API_URL to use https:
# NEXT_PUBLIC_API_URL=https://localhost:3000

# ─── Alert Engine / Email Notifications (Misión 14) ───────────────────────────
# SMTP server for outgoing alert emails.
# Gmail example (use an App Password, not your regular password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false       # true only for port 465
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # 16-char App Password
#
# Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=your@company.com
#   SMTP_PASS=yourpassword
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Destination address for all alert reports
ALERT_RECIPIENT=admin@yourdomain.com

# Days ahead to start warning about expiring items (default: 30)
ALERT_WARN_DAYS=30

# Cron schedule for the daily alert job (default: 08:30 AM Europe/Madrid).
# Use "* * * * *" to trigger every minute for testing.
# Syntax: minute hour day month weekday
ALERT_CRON_SCHEDULE=30 8 * * *

# ─── Database Maintenance (Misión 3) ──────────────────────────────────────────
# Retention period for audit logs (days). Older records are purged automatically.
# Default: 365 days (1 year). Set to 0 to disable automatic purge.
AUDIT_RETENTION_DAYS=365

# ─── MFA / Trusted Devices ────────────────────────────────────────────────────
# Days before a trusted device must re-authenticate with MFA.
TRUSTED_DEVICE_TTL_DAYS=30
# Same value shown in the UI (must match the backend value above).
NEXT_PUBLIC_TRUSTED_DEVICE_TTL_DAYS=30

# ─── Password Policy (local users only — LDAP/AD users are excluded) ──────────
# Minimum password length for ADMIN users (default: 16).
PASSWORD_MIN_LENGTH_ADMIN=16
# Minimum password length for AUDITOR and VIEWER users (default: 12).
PASSWORD_MIN_LENGTH_VIEWER=12
# Number of previous passwords stored per user. The user cannot reuse any of
# the last N passwords (default: 20).
PASSWORD_HISTORY_COUNT=20

# ─── LDAP / Active Directory Authentication ───────────────────────────────────
# Set USE_LDAP=true to enable hybrid authentication (local + LDAP/AD).
# When enabled, login attempts that don't end in @cmdb.local or @cmdb.internal
# are first checked against the LDAP server. On first successful LDAP login,
# a shadow user record is auto-created in the DB with role VIEWER.
# If LDAP is unreachable the local bcrypt path takes over (fail-safe, 5s timeout).
#
# Minimal config (direct user bind — works for AD with UPN):
#   USE_LDAP=true
#   LDAP_URL=ldap://dc.corp.local:389
#   LDAP_SEARCH_BASE=dc=corp,dc=local
#
# Full config (service-account bind + search — recommended for AD):
#   USE_LDAP=true
#   LDAP_URL=ldap://dc.corp.local:389
#   LDAP_BIND_DN=cn=svc-cmdb,ou=ServiceAccounts,dc=corp,dc=local
#   LDAP_BIND_PASSWORD=ServiceAccountPassword
#   LDAP_SEARCH_BASE=ou=Users,dc=corp,dc=local
#
# For LDAPS (port 636) with a self-signed / internal CA cert:
#   LDAP_URL=ldaps://dc.corp.local:636
#   LDAP_TLS_REJECT_UNAUTHORIZED=0   # Only in controlled environments!
USE_LDAP=false
LDAP_URL=ldap://dc.corp.local:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=dc=corp,dc=local
# LDAP_TLS_REJECT_UNAUTHORIZED=0    # Uncomment only for self-signed certs

# ─── Application Environment (Misión 4) ───────────────────────────────────────
# Controls logging verbosity and UI helpers.
# Values: 'prod' (production) or 'dev' (development)
# - prod: Minimal logs (warn/error only), no UI helpers
# - dev: Verbose logs (Prisma queries, LDAP traces), UI helpers visible
APP_ENV=prod
NEXT_PUBLIC_APP_ENV=prod

# ─── Corporate Branding (White-Label) ─────────────────────────────────────────
# Customize the platform with your company's identity.
NEXT_PUBLIC_COMPANY_NAME=CMDB Enterprise
NEXT_PUBLIC_LOGO_URL=/logo.png
NEXT_PUBLIC_THEME_COLOR=#4f46e5
