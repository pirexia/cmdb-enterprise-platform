# ══════════════════════════════════════════════════════════════════════════════
# CMDB Enterprise Platform — Configuration Template
#
# Quickstart:
#   bash scripts/install.sh          ← interactive installer (recommended)
#   # or manually:
#   cp .env.example .env             ← copy this file
#   # Edit .env with your values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Architecture: Browser → nginx:443 → frontend:3001 | backend:3000 → postgres
# All traffic enters through nginx (HTTPS). No other ports are exposed.
# TLS certificates live in ./certs/  (server.crt + server.key).
#
# REQUIRED variables are marked with ← REQUIRED
# Everything else has a safe default and can be left as-is for a quick start.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production     # ← REQUIRED — strong random string

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret  # ← REQUIRED

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Public URL users type in the browser (same for frontend and API — nginx serves both).
# Local dev:   https://localhost
# Production:  https://cmdb.yourdomain.com
NEXT_PUBLIC_API_URL=https://localhost         # ← REQUIRED (baked into frontend image at build time)
FRONTEND_URL=https://localhost                # ← REQUIRED (backend uses this for SSO redirects / CORS)

# ─── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME=CMDB Enterprise      # ← REQUIRED (baked into frontend image)

# ─── Document storage ─────────────────────────────────────────────────────────
# Host path where uploaded documents are stored.
# Options: relative local path, absolute path, or NFS/CIFS mount point.
DOCUMENTS_STORAGE_PATH=./document-storage

# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — leave sections below commented-out unless you need the feature.
# ══════════════════════════════════════════════════════════════════════════════

# ─── SMTP / Email alerts ───────────────────────────────────────────────────────
# Leave SMTP_USER empty to disable outgoing email alerts entirely.
#
# Gmail: use an App Password (16 chars) — Settings → Security → App Passwords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx
#
# Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=your@company.com
#   SMTP_PASS=yourpassword
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_RECIPIENT=admin@yourdomain.com

# ─── LDAP / Active Directory ───────────────────────────────────────────────────
# Set USE_LDAP=true to enable hybrid authentication (local + LDAP/AD).
# On first successful LDAP login a shadow user is auto-created with role VIEWER.
#
# Minimal (AD UPN direct bind):
#   USE_LDAP=true
#   LDAP_URL=ldap://dc.corp.local:389
#   LDAP_BASE_DN=dc=corp,dc=local
#
# Full (service-account bind + search — recommended):
#   USE_LDAP=true
#   LDAP_URL=ldap://dc.corp.local:389
#   LDAP_BASE_DN=dc=corp,dc=local
#   LDAP_BIND_DN=cn=svc-cmdb,ou=ServiceAccounts,dc=corp,dc=local
#   LDAP_BIND_PASSWORD=ServiceAccountPassword
#
# For LDAPS with self-signed cert add: LDAP_TLS_REJECT_UNAUTHORIZED=0
USE_LDAP=false
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ─── Microsoft 365 SSO / Azure AD ─────────────────────────────────────────────
# Register an app in Azure Portal → App registrations.
# Set Redirect URI to: https://your-domain/api/auth/sso/microsoft/callback
USE_MICROSOFT_SSO=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
AZURE_ALLOWED_DOMAIN=
