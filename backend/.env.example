# Copy this file to .env and fill in your values
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
PORT=3000
JWT_SECRET="your-long-random-jwt-secret-here"

# ── LDAP / Active Directory (optional) ───────────────────────────────────────
# Set USE_LDAP=true to validate credentials against your corporate AD/LDAP.
# When false (default), the platform uses local bcrypt authentication.
USE_LDAP=false
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
# Service account for LDAP searches (required for user lookups in AD)
LDAP_BIND_DN=CN=cmdb-svc,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=service-account-password
# Set to 0 to accept self-signed / corporate CA certificates (LDAPS)
LDAP_TLS_REJECT_UNAUTHORIZED=0

# ── Database Maintenance ──────────────────────────────────────────────────────
# Retention period for audit logs (days). Older records are purged automatically.
# Default: 365 days (1 year). Set to 0 to disable automatic purge.
AUDIT_RETENTION_DAYS=365

# ── MFA / Trusted Devices ────────────────────────────────────────────────────
# How many days a device is trusted before MFA is required again.
TRUSTED_DEVICE_TTL_DAYS=30

# ── Application Environment ───────────────────────────────────────────────────
# Controls logging verbosity. Values: 'prod' or 'dev'
# - prod: Minimal logs (warn/error only)
# - dev: Verbose logs (Prisma queries, LDAP traces)
APP_ENV=prod
