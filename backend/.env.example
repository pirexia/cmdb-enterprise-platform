# Copy this file to .env and fill in your values
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
PORT=3000
JWT_SECRET="your-long-random-jwt-secret-here"

# ── LDAP / Active Directory (optional) ───────────────────────────────────────
# Set USE_LDAP=true to validate credentials against your corporate AD/LDAP.
# When false (default), the platform uses local bcrypt authentication.
USE_LDAP=false
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
# Service account for LDAP searches (required for user lookups in AD)
LDAP_BIND_DN=CN=cmdb-svc,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=service-account-password
# Set to 0 to accept self-signed / corporate CA certificates (LDAPS)
LDAP_TLS_REJECT_UNAUTHORIZED=0

# ── Microsoft 365 SSO (Azure AD / Entra ID) ──────────────────────────────────
# Set USE_MICROSOFT_SSO=true and fill the values below to enable SSO.
# Leave USE_MICROSOFT_SSO=false (default) to disable without removing config.
USE_MICROSOFT_SSO=false
# Your Azure AD tenant ID (found in Azure Portal → Azure Active Directory → Overview)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# App Registration client ID (found in App Registration → Overview)
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# App Registration client secret (App Registration → Certificates & secrets → New client secret)
AZURE_CLIENT_SECRET=your-client-secret-value
# Redirect URI — must be registered exactly as-is in the App Registration
AZURE_REDIRECT_URI=https://app.empresa.com/api/auth/sso/microsoft/callback
# Corporate email domain — only users from this domain can SSO (e.g., empresa.com)
AZURE_ALLOWED_DOMAIN=empresa.com
# Frontend URL — used to redirect users back after SSO (no trailing slash)
FRONTEND_URL=https://app.empresa.com
# Automatically create a VIEWER account for new SSO users (true/false, default: true)
AZURE_AUTO_PROVISION=true

# ── Database Maintenance ──────────────────────────────────────────────────────
# Retention period for audit logs (days). Older records are purged automatically.
# Default: 365 days (1 year). Set to 0 to disable automatic purge.
AUDIT_RETENTION_DAYS=365

# ── MFA / Trusted Devices ────────────────────────────────────────────────────
# How many days a device is trusted before MFA is required again.
TRUSTED_DEVICE_TTL_DAYS=30

# ── Application Environment ───────────────────────────────────────────────────
# Controls logging verbosity. Values: 'prod' or 'dev'
# - prod: Minimal logs (warn/error only)
# - dev: Verbose logs (Prisma queries, LDAP traces)
APP_ENV=prod
