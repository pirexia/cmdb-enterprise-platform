generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AUDITOR
  VIEWER
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  MISSION_CRITICAL
}

enum Environment {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

enum LocationType {
  SITE
  DATACENTER
  RACK
}

// ─── CI Type master (replaces old CIType enum) ────────────────────────────────

model CITypeCategory {
  code      String      @id
  name      String
  sortOrder Int         @default(0) @map("sort_order")
  ciTypes   CIType[]

  @@map("ci_type_categories")
}

model CIType {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique
  name         String
  categoryCode String          @map("category_code")
  sortOrder    Int             @default(0) @map("sort_order")
  isSystem     Boolean         @default(false) @map("is_system")

  category     CITypeCategory  @relation(fields: [categoryCode], references: [code])
  cis          CI[]

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("ci_types")
}

enum RelationType {
  HOSTS              // Source hosts/contains target (e.g., Physical Server hosts VM)
  DEPENDS_ON         // Source depends on target (e.g., App depends on Database)
  CONNECTED_TO       // Source is connected to target (e.g., Server connected to Switch)
  PROVIDES_SERVICE   // Source provides service to target
  BACKED_UP_BY       // Source is backed up by target
}

// ─── NIS2 / GDPR Enums (stored as TEXT in DB) ─────────────────────────────────

enum BusinessImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  username        String          @unique
  email           String          @unique
  password        String?         @map("password")
  role            UserRole        @default(VIEWER)
  ssoExternalId   String?         @unique @map("sso_external_id")
  active          Boolean         @default(true) @map("active")
  mfaSecret       String?         @map("mfa_secret")
  mfaEnabled      Boolean         @default(false) @map("mfa_enabled")
  mfaPromptedAt   DateTime?       @map("mfa_prompted_at")

  ownedCIs         CI[]             @relation("BusinessOwner")
  technicalLedCIs  CI[]             @relation("TechnicalLead")
  trustedDevices   TrustedDevice[]
  passwordHistory  PasswordHistory[]

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model TrustedDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@map("trusted_devices")
}

model PasswordHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_history")
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  
  cis       CI[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cost_centers")
}

model Location {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  type              LocationType
  parentLocationId  String?    @db.Uuid @map("parent_location_id")
  
  parentLocation    Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations    Location[] @relation("LocationHierarchy")
  
  cis               CI[]

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("locations")
}

model Vendor {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  
  contracts Contract[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("vendors")
}

model Contract {
  id                String     @id @default(uuid()) @db.Uuid
  contractNumber    String     @unique @map("contract_number")
  startDate         DateTime   @map("start_date")
  endDate           DateTime?  @map("end_date")
  vendorId          String     @db.Uuid @map("vendor_id")
  parentContractId  String?    @db.Uuid @map("parent_contract_id")
  
  vendor            Vendor     @relation(fields: [vendorId], references: [id])
  parentContract    Contract?  @relation("ContractAddendums", fields: [parentContractId], references: [id])
  addendums         Contract[] @relation("ContractAddendums")
  
  cis               CI[]       @relation("ContractToCI")

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("contracts")
}

// ─── Master Data ──────────────────────────────────────────────────────────────

model SupportArea {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  branches  Branch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_areas")
}

model Branch {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  branchCode      String      @unique @map("branch_code")
  physicalAddress String?     @map("physical_address")
  supportAreaId   String      @db.Uuid @map("support_area_id")

  supportArea     SupportArea @relation(fields: [supportAreaId], references: [id])
  cis             CI[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("branches")
}

model Manufacturer {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  models    DeviceModel[]

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("manufacturers")
}

model DeviceModel {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  manufacturerId String       @db.Uuid @map("manufacturer_id")

  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  cis            CI[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("device_models")
}

model Provider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("providers")
}

// ─── Configuration Item ───────────────────────────────────────────────────────

model CI {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  apiSlug         String       @unique @map("api_slug")
  criticality     Criticality
  environment     Environment
  eolDate            DateTime? @map("eol_date")
  eosDate            DateTime? @map("eos_date")
  ciTypeId           String?   @db.Uuid @map("ci_type_id")
  ciTypeDef          CIType?   @relation(fields: [ciTypeId], references: [id])
  lastCheckDate      DateTime? @map("last_check_date")
  verificationSource String?   @map("verification_source")

  // Governance
  status          String?      @default("ACTIVO") @map("status")
  inventoryNumber String?      @unique @map("inventory_number")

  // Assignment (user devices)
  assignedUser    String?      @map("assigned_user")
  userDni         String?      @map("user_dni")

  // Physical location (infra / datacenter)
  floor           String?      @map("floor")
  room            String?      @map("room")
  rack            String?      @map("rack")
  rackUnit        String?      @map("rack_unit")

  // Network
  vlan            String?      @map("vlan")
  consoleIp       String?      @map("console_ip")

  // Core FK relations
  businessOwnerId String?      @db.Uuid @map("business_owner_id")
  technicalLeadId String?      @db.Uuid @map("technical_lead_id")
  locationId      String?      @db.Uuid @map("location_id")
  costCenterId    String?      @db.Uuid @map("cost_center_id")
  parentCIId      String?      @db.Uuid @map("parent_ci_id")

  // Master data FK relations
  branchId        String?      @db.Uuid @map("branch_id")
  ciModelId       String?      @db.Uuid @map("ci_model_id")

  businessOwner   User?        @relation("BusinessOwner", fields: [businessOwnerId], references: [id])
  technicalLead   User?        @relation("TechnicalLead", fields: [technicalLeadId], references: [id])
  location        Location?    @relation(fields: [locationId], references: [id])
  costCenter      CostCenter?  @relation(fields: [costCenterId], references: [id])
  parentCI        CI?          @relation("CIHierarchy", fields: [parentCIId], references: [id])
  childCIs        CI[]         @relation("CIHierarchy")
  branch          Branch?      @relation(fields: [branchId], references: [id])
  ciModel         DeviceModel? @relation(fields: [ciModelId], references: [id])

  hardware        HardwareCI?
  software        SoftwareCI?

  vulnerabilities Json?        @map("vulnerabilities")
  agentStatus     Json?        @map("agent_status")

  // ─── NIS2 / ISO 22301 / GDPR ──────────────────────────────────────────────
  businessImpact     BusinessImpact?     @map("business_impact")
  recoveryPriority   Int?                @map("recovery_priority")
  rto                Int?                // Recovery Time Objective (minutes)
  rpo                Int?                // Recovery Point Objective (minutes)
  spofRisk           Boolean             @default(false) @map("spof_risk")
  containsPii        Boolean             @default(false) @map("contains_pii")
  dataClassification DataClassification? @map("data_classification")

  contracts       Contract[]   @relation("ContractToCI")

  // CI Relationships (N:M with attributes)
  relationsFrom   CIRelation[] @relation("SourceCI")
  relationsTo     CIRelation[] @relation("TargetCI")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("configuration_items")
}

// ─── CI Relationships (N:M with type attribute) ──────────────────────────────

model CIRelation {
  id           String       @id @default(uuid()) @db.Uuid
  sourceCiId   String       @db.Uuid @map("source_ci_id")
  targetCiId   String       @db.Uuid @map("target_ci_id")
  relationType RelationType @map("relation_type")

  sourceCI     CI           @relation("SourceCI", fields: [sourceCiId], references: [id], onDelete: Cascade)
  targetCI     CI           @relation("TargetCI", fields: [targetCiId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by")

  @@unique([sourceCiId, targetCiId, relationType])
  @@map("ci_relations")
}

model HardwareCI {
  ciId         String @id @db.Uuid @map("ci_id")
  serialNumber String @unique @map("serial_number")
  model        String
  manufacturer String
  
  ci           CI     @relation(fields: [ciId], references: [id])

  @@map("hardware_cis")
}

model SoftwareCI {
  ciId        String @id @db.Uuid @map("ci_id")
  version     String
  licenseType String @map("license_type")
  
  ci          CI     @relation(fields: [ciId], references: [id])

  @@map("software_cis")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  userEmail String   @map("user_email")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
