generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AUDITOR
  VIEWER
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  MISSION_CRITICAL
}

enum Environment {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

enum LocationType {
  SITE
  DATACENTER
  RACK
}

// ─── CI Type master (replaces old CIType enum) ────────────────────────────────

model CITypeCategory {
  code      String      @id
  name      String
  sortOrder Int         @default(0) @map("sort_order")
  ciTypes   CIType[]

  @@map("ci_type_categories")
}

model CIType {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique
  name         String
  categoryCode String          @map("category_code")
  sortOrder    Int             @default(0) @map("sort_order")
  isSystem     Boolean         @default(false) @map("is_system")

  category     CITypeCategory  @relation(fields: [categoryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  cis          CI[]

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([categoryCode])
  @@map("ci_types")
}

enum RelationType {
  HOSTS              // Source hosts/contains target (e.g., Physical Server hosts VM)
  DEPENDS_ON         // Source depends on target (e.g., App depends on Database)
  CONNECTED_TO       // Source is connected to target (e.g., Server connected to Switch)
  PROVIDES_SERVICE   // Source provides service to target
  BACKED_UP_BY       // Source is backed up by target
}

// ─── NIS2 / GDPR Enums (stored as TEXT in DB) ─────────────────────────────────

enum BusinessImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum CIStatus {
  ACTIVO
  INACTIVO
  RETIRADO
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  username        String          @unique @db.VarChar(100)
  email           String          @unique @db.VarChar(255)
  password        String?         @map("password") @db.VarChar(255)
  role            UserRole        @default(VIEWER)
  ssoExternalId   String?         @unique @map("sso_external_id") @db.VarChar(255)
  ssoProvider     String?         @map("sso_provider") @db.VarChar(50)
  active          Boolean         @default(true) @map("active")
  mfaSecret        String?         @map("mfa_secret") @db.VarChar(255)
  mfaEnabled       Boolean         @default(false) @map("mfa_enabled")
  mfaPromptedAt    DateTime?       @map("mfa_prompted_at")
  mfaPendingSecret String?         @map("mfa_pending_secret") @db.VarChar(255)

  ownedCIs         CI[]             @relation("BusinessOwner")
  technicalLedCIs  CI[]             @relation("TechnicalLead")
  trustedDevices   TrustedDevice[]
  passwordHistory  PasswordHistory[]
  ragChatSessions  RagChatSession[]

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model TrustedDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  token       String   @unique
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@index([userId])
  @@map("trusted_devices")
}

model PasswordHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_history")
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @unique @db.VarChar(255)

  cis       CI[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cost_centers")
}

model Location {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  type              LocationType
  parentLocationId  String?    @db.Uuid @map("parent_location_id")
  
  parentLocation    Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childLocations    Location[] @relation("LocationHierarchy")

  cis               CI[]

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([parentLocationId])
  @@map("locations")
}

model Vendor {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique

  contracts Contract[]
  licenses  License[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("vendors")
}

model Contract {
  id                String     @id @default(uuid()) @db.Uuid
  contractNumber    String     @unique @map("contract_number") @db.VarChar(100)
  startDate         DateTime   @map("start_date")
  endDate           DateTime?  @map("end_date")
  vendorId          String     @db.Uuid @map("vendor_id")
  parentContractId  String?    @db.Uuid @map("parent_contract_id")
  
  vendor            Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentContract    Contract?  @relation("ContractAddendums", fields: [parentContractId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  addendums         Contract[] @relation("ContractAddendums")

  cis               CI[]       @relation("ContractToCI")

  documents         DocumentContract[]

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([vendorId])
  @@index([parentContractId])
  @@map("contracts")
}

// ─── Master Data ──────────────────────────────────────────────────────────────

model SupportArea {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  branches  Branch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_areas")
}

model Branch {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @unique @db.VarChar(255)
  branchCode      String      @unique @map("branch_code") @db.VarChar(50)
  physicalAddress String?     @map("physical_address") @db.VarChar(500)
  supportAreaId   String      @db.Uuid @map("support_area_id")

  supportArea     SupportArea @relation(fields: [supportAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cis             CI[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([supportAreaId])
  @@map("branches")
}

model Manufacturer {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  models    DeviceModel[]

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("manufacturers")
}

model DeviceModel {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  manufacturerId String       @db.Uuid @map("manufacturer_id")

  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cis            CI[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([manufacturerId])
  @@map("device_models")
}

model Provider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("providers")
}

// ─── Configuration Item ───────────────────────────────────────────────────────

model CI {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(255)
  apiSlug         String       @unique @map("api_slug") @db.VarChar(300)
  criticality     Criticality
  environment     Environment
  eolDate            DateTime? @map("eol_date")
  eosDate            DateTime? @map("eos_date")
  ciTypeId           String?   @db.Uuid @map("ci_type_id")
  ciTypeDef          CIType?   @relation(fields: [ciTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastCheckDate      DateTime? @map("last_check_date")
  verificationSource String?   @map("verification_source") @db.VarChar(100)

  // Governance
  status          CIStatus     @default(ACTIVO) @map("status")
  inventoryNumber String?      @unique @map("inventory_number") @db.VarChar(100)

  // Assignment (user devices)
  assignedUser    String?      @map("assigned_user") @db.VarChar(255)
  userDni         String?      @map("user_dni") @db.VarChar(20)

  // Physical location (infra / datacenter)
  floor           String?      @map("floor") @db.VarChar(50)
  room            String?      @map("room") @db.VarChar(100)
  rack            String?      @map("rack") @db.VarChar(50)
  rackUnit        String?      @map("rack_unit") @db.VarChar(20)

  // Network
  vlan            String?      @map("vlan") @db.VarChar(20)
  consoleIp       String?      @map("console_ip") @db.VarChar(45)

  // Core FK relations
  businessOwnerId String?      @db.Uuid @map("business_owner_id")
  technicalLeadId String?      @db.Uuid @map("technical_lead_id")
  locationId      String?      @db.Uuid @map("location_id")
  costCenterId    String?      @db.Uuid @map("cost_center_id")
  parentCIId      String?      @db.Uuid @map("parent_ci_id")

  // Master data FK relations
  branchId        String?      @db.Uuid @map("branch_id")
  ciModelId       String?      @db.Uuid @map("ci_model_id")

  businessOwner   User?        @relation("BusinessOwner", fields: [businessOwnerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  technicalLead   User?        @relation("TechnicalLead", fields: [technicalLeadId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  location        Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  costCenter      CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentCI        CI?          @relation("CIHierarchy", fields: [parentCIId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childCIs        CI[]         @relation("CIHierarchy")
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ciModel         DeviceModel? @relation(fields: [ciModelId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  hardware        HardwareCI?
  software        SoftwareCI?

  vulnerabilities Json?        @map("vulnerabilities")
  agentStatus     Json?        @map("agent_status")

  // ─── NIS2 / ISO 22301 / GDPR ──────────────────────────────────────────────
  businessImpact     BusinessImpact?     @map("business_impact")
  recoveryPriority   Int?                @map("recovery_priority")
  rto                Int?                // Recovery Time Objective (minutes)
  rpo                Int?                // Recovery Point Objective (minutes)
  spofRisk           Boolean             @default(false) @map("spof_risk")
  containsPii        Boolean             @default(false) @map("contains_pii")
  dataClassification DataClassification? @map("data_classification")

  contracts       Contract[]   @relation("ContractToCI")

  // CI Relationships (N:M with attributes)
  relationsFrom   CIRelation[] @relation("SourceCI")
  relationsTo     CIRelation[] @relation("TargetCI")

  documents       DocumentCI[]
  licenses        License[]    @relation("LicenseToCI")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([ciTypeId])
  @@index([businessOwnerId])
  @@index([technicalLeadId])
  @@index([locationId])
  @@index([costCenterId])
  @@index([branchId])
  @@index([ciModelId])
  @@index([parentCIId])
  @@index([status])
  @@index([criticality])
  @@index([environment])
  @@index([createdAt])
  @@map("configuration_items")
}

// ─── CI Relationships (N:M with type attribute) ──────────────────────────────

model CIRelation {
  id           String       @id @default(uuid()) @db.Uuid
  sourceCiId   String       @db.Uuid @map("source_ci_id")
  targetCiId   String       @db.Uuid @map("target_ci_id")
  relationType RelationType @map("relation_type")

  sourceCI     CI           @relation("SourceCI", fields: [sourceCiId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetCI     CI           @relation("TargetCI", fields: [targetCiId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by")

  @@unique([sourceCiId, targetCiId, relationType])
  @@index([sourceCiId])
  @@index([targetCiId])
  @@map("ci_relations")
}

model HardwareCI {
  ciId         String @id @db.Uuid @map("ci_id")
  serialNumber String @unique @map("serial_number") @db.VarChar(255)
  model        String @db.VarChar(255)
  manufacturer String @db.VarChar(255)
  
  ci           CI     @relation(fields: [ciId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("hardware_cis")
}

model SoftwareCI {
  ciId        String @id @db.Uuid @map("ci_id")
  version     String @db.VarChar(100)
  licenseType String @map("license_type") @db.VarChar(100)
  
  ci          CI     @relation(fields: [ciId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("software_cis")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @map("entity_id") @db.VarChar(36)
  userEmail String   @map("user_email") @db.VarChar(255)
  details   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userEmail])
  @@index([action, createdAt(sort: Desc)], map: "idx_audit_logs_action_created_at")
  @@map("audit_logs")
}

// ─── Document Repository ──────────────────────────────────────────────────────

model DocumentType {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  isSystem  Boolean    @default(false) @map("is_system")
  documents Document[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("document_types")
}

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  readAdmin    Boolean  @default(true)  @map("read_admin")
  readAuditor  Boolean  @default(true)  @map("read_auditor")
  readViewer   Boolean  @default(true)  @map("read_viewer")

  documentTypeId String   @db.Uuid @map("document_type_id")
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Versioning: rootId null = root document; non-null = a version of rootId
  rootId         String?  @db.Uuid @map("root_id")
  root           Document?  @relation("DocumentVersions", fields: [rootId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       Document[] @relation("DocumentVersions")
  versionNumber  Int      @default(1) @map("version_number")
  isLatest       Boolean  @default(true) @map("is_latest")

  // File info
  fileName       String   @map("file_name")       // UUID-based stored filename
  originalName   String   @map("original_name")   // Original user filename
  mimeType       String   @map("mime_type")
  fileSize       Int      @map("file_size")        // bytes

  // Who uploaded
  uploadedBy     String   @map("uploaded_by")     // user email

  // Associations
  cis            DocumentCI[]
  contracts      DocumentContract[]
  licenses       DocumentLicense[]

  // RAG subsystem
  ragIndex       RagDocumentIndex[]
  ragChunks      RagChunk[]

  // Relations between documents
  relationsFrom  DocumentRelation[] @relation("SourceDocument")
  relationsTo    DocumentRelation[] @relation("TargetDocument")
  notes          DocumentNote[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([documentTypeId])
  @@index([rootId])
  @@index([rootId, isLatest])     // "find current version of a document"
  @@index([rootId, versionNumber]) // "list version history ordered by version"
  @@map("documents")
}

model DocumentRelation {
  id             String   @id @default(uuid()) @db.Uuid
  sourceDocId    String   @db.Uuid @map("source_doc_id")
  targetDocId    String   @db.Uuid @map("target_doc_id")
  relationType   String   @map("relation_type")  // AMENDMENT_OF, RELATED_TO, SUPERSEDES

  sourceDoc      Document @relation("SourceDocument", fields: [sourceDocId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetDoc      Document @relation("TargetDocument", fields: [targetDocId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceDocId, targetDocId])
  @@index([sourceDocId])
  @@index([targetDocId])
  @@map("document_relations")
}

model DocumentCI {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid @map("document_id")
  ciId       String   @db.Uuid @map("ci_id")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ci         CI       @relation(fields: [ciId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, ciId])
  @@index([documentId])
  @@index([ciId])
  @@map("document_cis")
}

model DocumentContract {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid @map("document_id")
  contractId String   @db.Uuid @map("contract_id")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, contractId])
  @@index([documentId])
  @@index([contractId])
  @@map("document_contracts")
}

model DocumentNote {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid @map("document_id")
  content    String
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([documentId])
  @@map("document_notes")
}

// ─── License Repository ───────────────────────────────────────────────────────

model LicenseMetricCategory {
  code      String          @id
  name      String
  sortOrder Int             @default(0) @map("sort_order")
  metrics   LicenseMetric[]

  @@map("license_metric_categories")
}

model LicenseMetric {
  id           String                @id @default(uuid()) @db.Uuid
  code         String                @unique
  name         String
  categoryCode String                @map("category_code")
  description  String?
  isSystem     Boolean               @default(false) @map("is_system")

  category     LicenseMetricCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  licenses     License[]

  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([categoryCode])
  @@map("license_metrics")
}

model LicenseTypeCategory {
  code      String        @id
  name      String
  sortOrder Int           @default(0) @map("sort_order")
  types     LicenseType[]

  @@map("license_type_categories")
}

model LicenseType {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  name         String
  categoryCode String              @map("category_code")
  description  String?
  isSystem     Boolean             @default(false) @map("is_system")

  category     LicenseTypeCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  licenses     License[]

  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([categoryCode])
  @@map("license_types")
}

model License {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(255)
  licenseNumber   String         @unique @map("license_number") @db.VarChar(100)

  vendorId        String?        @db.Uuid @map("vendor_id")
  vendor          Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  startDate       DateTime       @map("start_date")
  endDate         DateTime?      @map("end_date")

  licenseTypeId   String?        @db.Uuid @map("license_type_id")
  licenseType     LicenseType?   @relation(fields: [licenseTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  licenseMetricId String?        @db.Uuid @map("license_metric_id")
  licenseMetric   LicenseMetric? @relation(fields: [licenseMetricId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  metricValue     Int?           @map("metric_value")  // quantity (e.g. 50 named users)
  metricUnit      String?        @map("metric_unit") @db.VarChar(50)   // display label override

  cost            Decimal?       @db.Decimal(12, 2)
  currency        String?        @default("EUR") @db.VarChar(3)

  status          String?        @default("ACTIVO") @map("status")
  notes           String?

  parentLicenseId String?        @db.Uuid @map("parent_license_id")
  parentLicense   License?       @relation("LicenseAddendums", fields: [parentLicenseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  addendums       License[]      @relation("LicenseAddendums")

  cis             CI[]           @relation("LicenseToCI")
  documents       DocumentLicense[]
  licenseUsers    LicenseUser[]

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([vendorId])
  @@index([licenseTypeId])
  @@index([licenseMetricId])
  @@index([parentLicenseId])
  @@index([status])
  @@index([endDate])
  @@map("licenses")
}

model LicenseUser {
  id        String   @id @default(uuid()) @db.Uuid
  licenseId String   @db.Uuid @map("license_id")
  name      String   @db.VarChar(255)
  dni       String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)

  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([licenseId])
  @@map("license_users")
}

model DocumentLicense {
  id        String  @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid @map("document_id")
  licenseId  String @db.Uuid @map("license_id")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, licenseId])
  @@index([documentId])
  @@index([licenseId])
  @@map("document_licenses")
}

model AppSettings {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─── RAG Subsystem ────────────────────────────────────────────────────────────

model RagDocumentIndex {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @db.Uuid @map("document_id")
  versionNumber Int       @default(1) @map("version_number")
  status        String    @default("PENDING")
  errorMessage  String?   @map("error_message")
  chunkCount    Int       @default(0) @map("chunk_count")
  indexedAt     DateTime? @map("indexed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([status])
  @@index([documentId])
  @@map("rag_document_index")
}

model RagChunk {
  id            String                        @id @default(uuid()) @db.Uuid
  documentId    String                        @db.Uuid @map("document_id")
  versionNumber Int                           @default(1) @map("version_number")
  chunkIndex    Int                           @map("chunk_index")
  sectionPath   String?                       @map("section_path")
  pageStart     Int?                          @map("page_start")
  pageEnd       Int?                          @map("page_end")
  tokenCount    Int                           @default(0) @map("token_count")
  content       String
  embedding     Unsupported("vector(1024)")?
  metadata      Json                          @default("{}")
  createdAt     DateTime                      @default(now()) @map("created_at")

  document      Document                      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("rag_chunks")
}

model RagChatSession {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid @map("user_id")
  title     String           @default("Nueva consulta")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  RagChatMessage[]

  @@index([userId])
  @@index([createdAt])
  @@map("rag_chat_sessions")
}

model RagChatMessage {
  id         String         @id @default(uuid()) @db.Uuid
  sessionId  String         @db.Uuid @map("session_id")
  role       String
  content    String
  citations  Json           @default("[]")
  queryHash  String?        @map("query_hash")
  modelUsed  String?        @map("model_used")
  tokensUsed Int?           @map("tokens_used")
  latencyMs  Int?           @map("latency_ms")
  createdAt  DateTime       @default(now()) @map("created_at")

  session    RagChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("rag_chat_messages")
}
